# Supabase (required) - Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Catalog API
VITE_API_BASE_URL=https://dummyjson.com

# Store settings
VITE_DISCOUNT_RATE=0.1
VITE_DEFAULT_COUPON=DISCOUNT10
VITE_SUPPORT_EMAIL=support@example.com
VITE_SUPPORT_PHONE=+000000000000
VITE_ENABLE_GOOGLE_AUTH=true
VITE_PRODUCTS_PAGE_SIZE=20
VITE_SIMULATE_PAYMENT_DELAY_MS=1500
VITE_CURRENCY_CODE=USD
VITE_CURRENCY_LOCALE=en-US
VITE_SITE_NAME=Dokan
VITE_SITE_URL=http://localhost:5173
VITE_FREE_SHIPPING_THRESHOLD=0

# Server-only (never prefix with VITE_, never commit real values)
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
